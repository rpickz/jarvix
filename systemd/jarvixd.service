[Unit]
Description=Jarvix voice interaction daemon
Documentation=https://github.com/rpickz/jarvix
# PipeWire is socket-activated; a hard dependency is unnecessary, but starting
# after it avoids a startup race on login.
After=pipewire.service
# Tolerate transient startup failures (e.g. a stale socket race at login)
# without tripping systemd's default start limit.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
ExecStart=%h/.local/bin/jarvixd
Restart=on-failure
RestartSec=1
# The daemon only ever writes under XDG paths.
Environment=JARVIX_SERVICE=1

# Give jarvixd the user's session environment (PATH for whisper-cli/piper,
# API keys exported via systemctl --user set-environment).
[Install]
WantedBy=default.target
